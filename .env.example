# repo-root .env — the dev sandbox's LLM provider configuration.
#
# docker-compose.yaml substitutes ${VAR:-default} from this file, so a value
# set here reaches the `dev` and `worker` services. Every name below is one the
# application actually reads; there are no aliases.
#
# Two independent halves, and they can be mixed freely:
#   * Chat     — free hosted (GROQ_API_KEY) or a keyless local model server.
#   * Embedding— hosted OpenAI, or the same local model server.
# The zero-cost path needs only GROQ_API_KEY: no other provider offers
# embeddings, so a zero-cost deployment runs search in `keyword` mode unless the
# local server below is enabled too.

# --- Free hosted chat (https://console.groq.com/keys) -----------------------
GROQ_API_KEY=

# --- Hosted embeddings (semantic search) -------------------------------------
OPENAI_API_KEY=
EMBEDDING_MODEL=
# The width EMBEDDING_MODEL's vectors must be. Change both together: a vector
# of any other width cannot be written or compared, so the service refuses it
# loudly rather than storing it. 1536 is text-embedding-ada-002's width and
# also text-embedding-3-small's — which is why the model is recorded per row
# and filtered on, since those two are indistinguishable by width.
EMBEDDING_DIMENSIONS=1536

# --- Local model server, no API key (Ollama on the host) --------------------
# `host.docker.internal` is mapped by docker-compose.yaml, so it resolves from
# both services on Linux as well as Docker Desktop. See DEVELOPMENT.md for the
# host-side setup (OLLAMA_HOST) this repository cannot perform.
# LOCAL_LLM_ENABLED turns on the *chat* provider. It also turns on local
# *embeddings* — but only when no OPENAI_API_KEY is set. A deployment that
# already embeds with OpenAI keeps doing so, because silently moving it to a
# different embedding space would strand every vector it owns.
LOCAL_LLM_ENABLED=
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_MODEL=llama3.2:1b
# The local embedding model and its width. nomic-embed-text is 768-wide;
# all-minilm is 384 and mxbai-embed-large 1024, so change both lines together.
# `ollama pull nomic-embed-text` first — the worker needs the model present.
LOCAL_EMBEDDING_MODEL=nomic-embed-text
LOCAL_EMBEDDING_DIMENSIONS=768

# --- Optional overrides ------------------------------------------------------
# Pin the default QA model; empty means free-first resolution.
QA_MODEL=
# Answer length cap. Lower it for a CPU-only local model, where generation runs
# at a few tokens per second and the 1000-token default reads as a hang.
QA_MAX_TOKENS=1000
# Blank values fall back to the cheapest available model rather than failing.
OPENAI_MODEL=
# The OpenAI SDK's own variable: redirects both embeddings and OpenAI chat, so
# it is also how a local server or a test stub is pointed at.
OPENAI_BASE_URL=
