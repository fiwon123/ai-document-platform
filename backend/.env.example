# AI Document Intelligence Platform — Backend Environment
#
# Copy this file to backend/.env and adjust values for your environment.
# `load_dotenv()` picks it up when running uvicorn from the backend directory.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_HOST=localhost
# Host port of the dockerized PostgreSQL (container-internal port stays 5432)
POSTGRES_PORT=5434
# Full connection string (used by Alembic, overrides the components above)
DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5434/mydb

# --- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=63790
REDIS_DB=0
REDIS_PASSWORD=
# Redis connection pool size
REDIS_MAX_CONNECTIONS=20

# --- MinIO/S3 storage -------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
# Public endpoint used for presigned URLs (defaults to MINIO_ENDPOINT when empty)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
# Use TLS for MinIO connections (true/false)
MINIO_SECURE=false
MINIO_REGION=us-east-1

# --- JWT authentication ------------------------------------------------------
# REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# The value below is committed to this repository, so the app REFUSES TO BOOT with
# it: anyone who can read the repo could mint access tokens for the deployment.
# The docker-compose dev sandbox sets the acknowledgement for you; for the
# host-native loop, either uncomment it below (local development only) or replace
# SECRET_KEY with a generated one.
SECRET_KEY=your-secret-key-change-in-production
# ALLOW_PLACEHOLDER_SECRET_KEY=1
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Send the refresh cookie only over HTTPS (set false for local HTTP dev)
REFRESH_COOKIE_SECURE=true

# --- AI providers -------------------------------------------------------------
# OpenAI API key (document embeddings + Q&A when Groq is not used)
OPENAI_API_KEY=
# Groq API key (alternative LLM provider for Q&A)
GROQ_API_KEY=
OPENAI_MODEL=gpt-4
# The OpenAI-space embedding model and the width its vectors must be. Change
# both together: a vector of any other width cannot be written or compared.
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSIONS=1536
# The local (Ollama) embedding space, used only when OPENAI_API_KEY is unset, so
# an existing OpenAI deployment is never silently moved out of its own space.
# nomic-embed-text is 768-wide; all-minilm 384, mxbai-embed-large 1024.
LOCAL_EMBEDDING_MODEL=nomic-embed-text
LOCAL_EMBEDDING_DIMENSIONS=768
# The keyless local model server. This is what turns the local space on: with no
# OPENAI_API_KEY, LOCAL_LLM_ENABLED enables local embeddings as well as local
# chat, which is what makes a zero-cost deployment's semantic search work.
# Leave the base URL empty to use the default, http://localhost:11434/v1.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2:1b

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
# Trust X-Forwarded-For for client IP detection (true/false; enable behind a proxy)
TRUST_PROXY_HEADERS=false

# --- CORS ----------------------------------------------------------------------
# Comma-separated allowed origins. Defaults to dev ports 5173/5175/3000.
# Use a bare "*" for a wildcard (dev/testing only — disables credentialed requests).
# CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# --- Tests ---------------------------------------------------------------------
# Name of the PostgreSQL database the test suite creates/uses
# (only relevant when running `uv run pytest`)
TEST_DB_NAME=mydb_test