# syntax=docker/dockerfile:1

# Production backend image for the AI Document Intelligence Platform.
# Build context: ./backend  (docker build -f infra/docker/Dockerfile.backend ./backend)
#
# Multi-stage build:
#   build   -> installs locked production dependencies with uv
#   runtime -> slim Python image, non-root user, only what the API needs

# uv version, bump via --build-arg UV_VERSION=x.y.z
#
# This ARG must stay in *global* scope (before the first FROM) so the uv stage
# below can expand it. Keep it there.
ARG UV_VERSION=0.6.1

# ---------- uv stage ----------
# BuildKit refuses variable expansion in `COPY --from`
# ("variable expansion is not supported for --from"), so the pinned uv image
# cannot be written as `COPY --from=ghcr.io/astral-sh/uv:${UV_VERSION}`.
# Consuming the ARG in a FROM and referencing the stage by name is the
# documented workaround, and it keeps `--build-arg UV_VERSION=x.y.z` working.
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

# ---------- Build stage ----------
FROM python:3.14-slim AS build

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# System deps needed to compile native wheels (psycopg2 etc.).
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install uv (pinned to avoid surprises).
COPY --from=uv /uv /usr/local/bin/uv

# Copy project metadata + source, then install locked deps (no dev group).
COPY pyproject.toml uv.lock README.md ./
COPY src/ ./src/
RUN uv sync --frozen --no-dev

# ---------- Runtime stage ----------
FROM python:3.14-slim AS runtime

WORKDIR /app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app/src"

# Trim the base image before anything is copied in, so this layer stays cached
# independently of the application source (#660).
#
# `apt-get upgrade` picks up the Debian security fixes that the floating
# `python:3.14-slim` tag had not moved to yet: libpcre2-8-0 CVE-2026-103111
# (HIGH, out-of-bounds write via a crafted regular expression) is fixed in
# 10.46-1~deb13u3. Waiting for the tag to catch up is not a fix, the same way a
# deleted image is not something a newer tag repairs. `upgrade` rather than
# `full-upgrade`, so a package is never removed as a side effect.
#
# Uninstalling pip removes the packages it vendors. The venv is built by
# `uv sync` in the build stage and copied in whole, `uv` never reaches this
# stage, and nothing installs anything at runtime — so pip is dead weight that
# carries msgpack 1.1.2 (GHSA-6v7p-g79w-8964) and setuptools 70.3.0
# (CVE-2025-47273). Trivy reads those out of pip's bundled-license tree and
# reports them as installed packages, which is how an image with neither
# dependency came to be scanned for them.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
 && rm -rf /var/lib/apt/lists/* \
 && python -m pip uninstall -y pip \
 && rm -rf /root/.cache/pip

# The app runs as a non-root user in production.
#
# The uid/gid are fixed and the USER instruction below is NUMERIC on purpose.
# `USER app` records the *name* in the image config, and the kubelet then
# refuses the container under `runAsNonRoot` with "image has non-numeric user
# (app), cannot verify user is non-root" — which is how the migrate Job, and
# every pod built on this image, failed to start (#650). `--system` would also
# pick an arbitrary uid from the system range, so a base-image change could
# silently move it. 1001 matches the uid the Kubernetes manifests already use.
RUN groupadd --gid 1001 app \
 && useradd --uid 1001 --gid app --create-home --no-log-init app

# Copy the ready-made virtualenv and the thin runtime files.
COPY --from=build /app/.venv /app/.venv
COPY --from=build /app/src /app/src
COPY migrations/ ./migrations/
COPY alembic.ini ./

USER 1001:1001

EXPOSE 8000

# One uvicorn process per Pod; horizontal scaling happens at the
# Kubernetes level (replicas / HPA), which is the idiomatic K8s model.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
