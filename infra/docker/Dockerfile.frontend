# syntax=docker/dockerfile:1

# Production frontend image for the AI Document Intelligence Platform.
# Build context: ./frontend  (docker build -f infra/docker/Dockerfile.frontend ./frontend)
#
# Multi-stage build:
#   build  -> type-check + Vite production build (node:22-alpine)
#   runtime -> nginx serving the static SPA + proxying /v1 to the backend

# ---------- Build stage ----------
FROM node:22-alpine AS build

WORKDIR /app

# npm ci is deterministic (uses the lockfile).
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# "build" runs tsc -b && vite build -> dist/
RUN npm run build

# ---------- Runtime stage ----------
# nginxinc/nginx-unprivileged listens on 8080 as a non-root user (uid 101), so
# the image satisfies runAsNonRoot / restricted Pod Security. The base declares
# that uid numerically; it is repeated explicitly below, because the package
# upgrade has to enter root and come back.
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

# Trim the base image before anything is copied in, so this layer stays cached
# independently of the application source (#670).
#
# `apk upgrade` — not #661's `apt-get upgrade`: this base is Alpine, and the CVE
# version strings in the scan (1.34.5-r0, 3.3.3-r0) are Alpine `-rN` revisions.
# It picks up 42 findings the scan reported against this image (40 HIGH, 2
# CRITICAL) that no change to our own code can reach — all of them in packages
# inherited from the base:
#
#   c-ares     1.34.5-r0 -> 1.34.8-r0    libpng  1.6.47-r0 -> 1.6.59-r0
#   libcrypto3 3.3.3-r0 -> 3.3.7-r2    libssl3 3.3.3-r0 -> 3.3.7-r2
#   libexpat   2.7.0-r0 -> 2.8.4-r0
#
# 3.3.7-r2 carries CVE-2026-31789 (CRITICAL, OpenSSL heap buffer overflow);
# 3.3.3-r0 was two patch releases behind. `1.27-alpine` is a floating tag that had
# not moved to a patched Alpine, and waiting for it to is not a fix — the same
# argument as `python:3.14-slim` in #661, and the same argument that a deleted
# image is not something a newer tag repairs. `upgrade` rather than a
# `--available`-style reinstall, so nothing is removed as a side effect.
#
# The upgrade needs write access to the apk database, and this base runs as uid
# 101 — so root is entered for this one instruction and left again. The trailing
# `USER 101` is the base image's own value, repeated *numerically* for the
# reason in #650: `runAsNonRoot` cannot be verified from a user *name*, so
# spelling it `USER nginx` here would reintroduce exactly that gap in this image.
USER root
RUN apk upgrade --no-cache
USER 101

# SPA routing, gzip, cache headers, /v1 proxy to the backend service.
COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
    CMD wget -qO- http://localhost:8080/ > /dev/null 2>&1
