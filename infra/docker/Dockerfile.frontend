# syntax=docker/dockerfile:1

# Production frontend image for the AI Document Intelligence Platform.
# Build context: ./frontend  (docker build -f infra/docker/Dockerfile.frontend ./frontend)
#
# Multi-stage build:
#   build  -> type-check + Vite production build (node:22-alpine)
#   runtime -> nginx serving the static SPA + proxying /v1 to the backend

# ---------- Build stage ----------
FROM node:22-alpine AS build

WORKDIR /app

# npm ci is deterministic (uses the lockfile).
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# "build" runs tsc -b && vite build -> dist/
RUN npm run build

# ---------- Runtime stage ----------
FROM nginx:1.27-alpine AS runtime

# SPA routing, gzip, cache headers, /v1 proxy to the backend service.
COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

# nginx runs as a non-root user out of the box on alpine (user nginx).
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
    CMD wget -qO- http://localhost/ > /dev/null 2>&1