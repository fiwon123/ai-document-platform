# MinIO: S3-compatible object storage, built from source.
#
# WHY NOT A PRE-BUILT BINARY (replaces the original download note — #703)
#
# The official published image can no longer be pulled by anyone, from any
# registry:
#
#   docker.io/minio/minio     -> HTTP 404, "object not found" (repo deleted)
#   quay.io/minio/minio       -> HTTP 401, anonymous manifest pull refused
#   quay.io/minio/mc          -> HTTP 401, same
#   dl.min.io/.../linux-amd64 -> HTTP 410 Gone
#
# Upstream then moved the community edition to SOURCE-ONLY distribution:
# the github.com/minio/minio repo is now ARCHIVED and its release assets /
# dl.min.io binaries are frozen legacy artifacts "that will not receive
# updates" (minio/minio README). The last pre-built binary —
# RELEASE.2025-09-07 — carries Go standard-library vulnerabilities with known
# fixes (CVE-2026-56858 html/template XSS, CVE-2026-56859 encoding/xml DoS,
# CVE-2026-56860 net/url DoS, CVE-2026-56862 crypto/tls DoS), which this
# release's Trivy gate fails on by design: "actionable findings block the
# merge until the base images are bumped". There is no *binary* to bump to,
# so the image is built from source here, which is exactly what upstream
# recommends ('go install github.com/SimpleDataLabsInc/minio@latest' — the
# continuation repo, since the old org is archived).
#
# Pinning posture (same principle the binary download used): MINIO_REF is an
# exact commit SHA — the build fetches it and refuses to proceed unless HEAD
# resolves to it, so the image is reproducible until someone deliberately
# bumps the pin. The golang builder image is pinned by digest so the
# toolchain cannot drift between builds. A future bump is: update MINIO_REF
# (+ the golang digest), rebuild, re-run Trivy.
#
# The continuation repo publishes no release tags, so the pin is the commit:
# e313adaa08acd21372d8d18de2ddd1dacdf888c6 is the master head at the time of
# writing (post "Dependency CVE remediation" — govulncheck-driven dep bumps).
#
# Dependency override: upstream pins google.golang.org/grpc v1.83.1, which has
# CVE-2026-84445 (gRPC-Go DoS, fixed in v1.83.2) — the Trivy gate blocks on
# it. The `go get google.golang.org/grpc@v1.83.2` in the build step is a
# pinned, deliberate remediation (same philosophy as upstream's own
# govulncheck bumps); once MINIO_REF is bumped past the commit that lifts
# grpc, the line becomes a no-op and can be removed.

FROM golang:1.26-alpine@sha256:66f9a494af2b76ecb3eab75ff47166df61caec6d200c59d556b77327493d83a8 AS build

ARG MINIO_REPO=SimpleDataLabsInc/minio
ARG MINIO_REF=e313adaa08acd21372d8d18de2ddd1dacdf888c6

RUN apk add --no-cache git ca-certificates

WORKDIR /src
RUN git init -q minio \
 && git -C minio remote add origin "https://github.com/${MINIO_REPO}" \
 && git -C minio fetch -q --depth 1 origin master \
 && git -C minio checkout -q "${MINIO_REF}" \
 && test "$(git -C minio rev-parse HEAD)" = "${MINIO_REF}"

WORKDIR /src/minio
ENV CGO_ENABLED=0
# The main package lives at the repo root (go.mod + main.go). Version vars
# live in package cmd (build-constants.go) and are ldflags-fed; embed the
# pinned commit and its date so `minio --version` identifies the binary.
RUN MINIO_VERSION="$(git -C /src/minio show -s --format=%cI HEAD)" \
 && MINIO_MOD="$(grep '^module ' /src/minio/go.mod | awk '{print $2}')" \
 && go get google.golang.org/grpc@v1.83.2 \
 && go build -trimpath \
      -ldflags="-s -w \
        -X ${MINIO_MOD}/cmd.Version=${MINIO_VERSION} \
        -X ${MINIO_MOD}/cmd.ReleaseTag=${MINIO_REF:0:12} \
        -X ${MINIO_MOD}/cmd.CommitID=${MINIO_REF} \
        -X ${MINIO_MOD}/cmd.ShortCommitID=${MINIO_REF:0:12}" \
      -o /out/minio . \
 && /out/minio --version

FROM alpine:3.20

# ca-certificates so MinIO can talk to a TLS endpoint if one is ever configured
# in front of it; the static binary itself needs nothing else.
RUN apk add --no-cache ca-certificates

COPY --from=build /out/minio /usr/local/bin/minio

# Deliberately no USER directive. /data is a PersistentVolumeClaim mounted by the
# kubelet and owned by root, so dropping to an unprivileged uid here would make
# MinIO unable to write. The official image runs as root for the same reason;
# if MinIO is ever hardened to a non-root uid, the volume ownership has to be
# fixed at the same time or this breaks in a much more confusing way.

EXPOSE 9000 9001

# The k8s StatefulSet overrides this with an explicit
# `command: ["minio", "server", ...]`, which replaces ENTRYPOINT — hence the
# binary lives on PATH rather than being invoked by absolute path only.
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]